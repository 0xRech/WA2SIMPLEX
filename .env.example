# HTTP server
PORT=3000

# Meta / WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=change-me-to-a-long-random-string
WHATSAPP_ACCESS_TOKEN=EA...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_APP_SECRET=your-meta-app-secret
# Keep this configurable because Meta retires Graph API versions over time.
WHATSAPP_API_VERSION=v26.0
WHATSAPP_MARK_READ=true

# SimpleX CLI WebSocket API
# Start SimpleX separately with: simplex-chat -p 5225
SIMPLEX_WS_URL=ws://127.0.0.1:5225

# Direct SimpleX contact of the human who will use the bridge.
# WA2SimpleX creates one private SimpleX group per WhatsApp contact and invites this contact.
SIMPLEX_CONTROL_TARGET=@2
SIMPLEX_GROUP_PREFIX=WA

# Persistent routing metadata only; message bodies are not stored here.
DB_PATH=./data/wa2simplex.db

# v0.3 media bridge. Files are stored here only temporarily during transfer.
MEDIA_ENABLED=true
MEDIA_DIR=./data/media
# Keep this conservative on small VPS instances. The bridge currently buffers WhatsApp uploads/downloads in memory.
MEDIA_MAX_MB=32
# Safety cleanup for interrupted transfers.
MEDIA_RETENTION_MINUTES=60

# Logging: debug | info | warn | error
LOG_LEVEL=info
