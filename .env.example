# HTTP server
PORT=3000

# Meta / WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=change-me-to-a-long-random-string
WHATSAPP_ACCESS_TOKEN=EA...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_APP_SECRET=your-meta-app-secret
# Keep this configurable because Meta retires Graph API versions over time.
WHATSAPP_API_VERSION=v23.0
WHATSAPP_MARK_READ=true

# SimpleX CLI WebSocket API
# Start SimpleX separately with: simplex-chat -p 5225
SIMPLEX_WS_URL=ws://127.0.0.1:5225
# Numeric SimpleX chat reference of your private bridge chat: @<contactId> or #<groupId>
SIMPLEX_TARGET=@2

# Optional: refuse SimpleX commands/messages unless they come from SIMPLEX_TARGET.
# Recommended: true.
SIMPLEX_RESTRICT_TO_TARGET=true

# Logging: debug | info | warn | error
LOG_LEVEL=info
